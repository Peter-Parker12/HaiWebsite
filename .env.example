# Copy to .env and fill in. Never commit .env.

# Database password (used by both the db and app containers)
DB_PASSWORD=change-me-to-a-long-random-string

# First admin account, created on startup if set (the admin screen comes in a later step)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true = create demo accounts (password: demo1234) and show the demo buttons.
# Set to false for a real launch.
SEED_DEMO=true

# Session cookie is only sent over HTTPS. Keep true behind the Cloudflare tunnel.
COOKIE_SECURE=true
